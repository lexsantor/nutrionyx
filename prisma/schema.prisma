// Nutrionyx slice 1 - Assessment aggregate and identity spine.
// Domain source: docs/09_Domain_Model.md. Every model is org-scoped.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Specialist sub-role (adr/0006). Configuration only - drives dashboard,
// terminology and templates - never RBAC. Lives on the consulta, not the
// permission model, so operator-blindness is unaffected.
enum SpecialtyType {
  DIETITIAN
  SPORTS_NUTRITIONIST
}

model Organization {
  id        String    @id @default(cuid())
  // Better Auth organization id (Neon Auth); see deviations/0001.
  authOrgId String    @unique
  name      String
  // Sub-role (adr/0006): nullable until chosen at activation; freely editable
  // in Ajustes. Configuration, not access.
  specialtyType SpecialtyType?
  // Consulta profile (docs/build/slice-4-plan.md). All optional; fiscal
  // fields feed Billing invoices later. Editable by the owning specialist.
  legalName   String?
  taxId       String?
  addressLine String?
  locality    String?
  postalCode  String?
  country     String?  @default("ES")
  hours       String?
  logoUrl     String?
  slug        String?  @unique
  createdAt DateTime  @default(now())
  patients  Patient[]

  @@map("organizations")
}

enum PatientStatus {
  INVITED
  ACTIVE
}

model Patient {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  // Better Auth user id (Neon Auth); set when the invited patient activates.
  authUserId     String?       @unique
  email          String
  fullName       String?
  status         PatientStatus @default(INVITED)
  createdAt      DateTime      @default(now())
  assessments    Assessment[]
  measurements   Measurement[]
  medicationPlan  MedicationPlan?
  medicationDoses MedicationDose[]
  target          PatientTarget?
  notes           PatientNote[]
  mealLogs        MealLog[]
  photos          PatientPhoto[]
  documents       PatientDocument[]
  dietPlan        DietPlan?
  trainingRoutine  TrainingRoutine?
  trainingSessions TrainingSession[]
  messages         Message[]
  appointments     Appointment[]

  // Invariant (docs/09): every patient belongs to exactly one organization.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("patients")
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
}

enum Sex {
  FEMALE
  MALE
}

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id])
  status         AssessmentStatus @default(IN_PROGRESS)
  version        Int              @default(1)
  predecessorId  String?          @unique
  predecessor    Assessment?      @relation("AssessmentVersions", fields: [predecessorId], references: [id])
  successor      Assessment?      @relation("AssessmentVersions")

  // Core clinical intake (editable while IN_PROGRESS, frozen at COMPLETED;
  // required-at-completion is enforced in the domain layer, not the schema)
  sex               Sex?
  birthDate         DateTime?
  heightCm          Decimal?  @db.Decimal(5, 1)
  weightKg          Decimal?  @db.Decimal(5, 1)
  targetWeightKg    Decimal?  @db.Decimal(5, 1)
  activityLevel     ActivityLevel?
  goals             String[]
  conditions        String?
  allergies         String?
  currentMedication String?

  // Computed at completion (docs/09: BMI, target delta ratio)
  bmi              Decimal? @db.Decimal(4, 1)
  targetDeltaRatio Decimal? @db.Decimal(5, 4)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([patientId, version])
  @@index([organizationId])
  @@map("assessments")
}

// Append-only domain events (docs/09: AssessmentStarted, AssessmentCompleted)
model DomainEvent {
  id             String   @id @default(cuid())
  organizationId String
  aggregate      String
  aggregateId    String
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([organizationId, aggregate, aggregateId])
  @@map("domain_events")
}

// Append-only patient metrics over time (docs/09 Measurement child of
// Patient, docs/build/slice-2-plan.md). Weight only for this slice; never
// updated or deleted - a correction is a new row.
enum MeasurementKind {
  WEIGHT
  PROTEIN
  WAIST_CM
  HIP_CM
  BODY_FAT_PCT
  CHEST_CM
  ARM_CM
  THIGH_CM
  GLUTE_CM
  CALF_CM
}

model Measurement {
  id             String          @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  kind           MeasurementKind @default(WEIGHT)
  value          Decimal         @db.Decimal(5, 1)
  recordedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, patientId, recordedAt])
  @@map("measurements")
}

// Progress photos (docs/build/slice-14-plan.md). Art. 9 data: blobs live in
// the PRIVATE store and are served only through the auth-gated photo route.
// Patient-owned; the specialist of the org reads; the admin never sees them.
model PatientPhoto {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  pathname       String
  contentType    String
  createdAt      DateTime @default(now())

  @@index([organizationId, patientId, createdAt])
  @@map("patient_photos")
}

// Diet Plan aggregate root (PRD_03 §3.5; docs/build/slice-17-plan.md -
// resolves the docs/09 reconciliation flag as its own root). One editable
// plan per patient; `content` is the whole 7-day x 5-meal document (always
// read/written together). Edit history via DietPlanSaved events.
model DietPlan {
  id                  String   @id @default(cuid())
  organizationId      String
  patientId           String   @unique
  patient             Patient  @relation(fields: [patientId], references: [id])
  title               String?
  notes               String?
  content             Json
  updatedByAuthUserId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
  @@map("diet_plans")
}

// Exercise Program aggregate root (PRD_03 §3.5; docs/build/slice-18-plan.md).
// Same document pattern as DietPlan: 7 day-texts, empty = rest day.
model TrainingRoutine {
  id                  String   @id @default(cuid())
  organizationId      String
  patientId           String   @unique
  patient             Patient  @relation(fields: [patientId], references: [id])
  title               String?
  notes               String?
  content             Json
  updatedByAuthUserId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
  @@map("training_routines")
}

// Append-only training sessions the patient marks done (one per day).
model TrainingSession {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  note           String?
  sessionAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, patientId, sessionAt])
  @@map("training_sessions")
}

// Scheduling (docs/build/slice-20-plan.md): specialist-managed citas.
// Cancelled rows are kept (history); startsAt is a UTC instant parsed and
// rendered as Europe/Madrid wall-clock (single-market decision).
enum AppointmentStatus {
  SCHEDULED
  CANCELLED
}

enum AppointmentMode {
  IN_PERSON
  VIDEO
}

model Appointment {
  id                  String            @id @default(cuid())
  organizationId      String
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id])
  startsAt            DateTime
  durationMin         Int               @default(60)
  mode                AppointmentMode   @default(IN_PERSON)
  videoUrl            String?
  note                String?
  status              AppointmentStatus @default(SCHEDULED)
  createdByAuthUserId String
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())

  @@index([organizationId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@map("appointments")
}

// Messaging (docs/build/slice-19-plan.md): one async thread per patient,
// patient ↔ their consulta. readAt is set when the counterpart opens the
// thread (mark-all-read). No edit/delete - a correction is a new message.
enum MessageSender {
  SPECIALIST
  PATIENT
}

model Message {
  id               String        @id @default(cuid())
  organizationId   String
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  sender           MessageSender
  senderAuthUserId String
  body             String
  readAt           DateTime?
  createdAt        DateTime      @default(now())

  @@index([organizationId, patientId, createdAt])
  @@map("messages")
}

// Patient documents (docs/build/slice-16-plan.md): PDFs/reports the
// specialist shares with a patient. Private Blob store, auth-gated route.
model PatientDocument {
  id                 String   @id @default(cuid())
  organizationId     String
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id])
  pathname           String
  contentType        String
  fileName           String
  uploadedByAuthUserId String
  createdAt          DateTime @default(now())

  @@index([organizationId, patientId, createdAt])
  @@map("patient_documents")
}

// Specialist-private clinical notes (docs/build/slice-10-plan.md).
// Append-only (PRD_03 rules 5-6): a correction is a new note. Never shown
// to the patient; never visible to the platform admin (operator-blindness).
// How a prescribed meal actually went (docs/build/slice-30-plan.md). Not a
// measurement: it is the state of one meal on one day, so a correction is an
// update rather than a new row, and (patient, date, slot) is unique. The
// append-only rule in PRD_03 rules 5-6 is about facts that accumulate; a tick
// the patient can untick is not one.
enum MealStatus {
  DONE
  CHANGED
  SKIPPED
}

model MealLog {
  id             String     @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id])
  /** Madrid calendar day, at midnight, so a day is a day and not an instant. */
  day            DateTime   @db.Date
  slot           String
  status         MealStatus
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([patientId, day, slot])
  @@index([organizationId, patientId, day])
  @@map("meal_logs")
}

model PatientNote {
  id               String   @id @default(cuid())
  organizationId   String
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
  authorAuthUserId String
  body             String
  createdAt        DateTime @default(now())

  @@index([organizationId, patientId, createdAt])
  @@map("patient_notes")
}

// Reusable week templates (docs/build/slice-21-plan.md). Org-scoped and
// NOT tied to a patient: a specialist saves a week once and loads it into
// any patient of the same consulta. Cross-org reuse is deliberately
// impossible - it would breach tenant isolation (LPEF Prisma R2/R4).
model DietTemplate {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  content             Json
  createdByAuthUserId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("diet_templates")
}

model TrainingTemplate {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  content             Json
  createdByAuthUserId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("training_templates")
}

// Clinical targets prescribed by the specialist (docs/build/slice-9-plan.md):
// kcal reference, daily protein grams, training sessions per week. One per
// patient, org-scoped, editable - unlike Measurement facts this is config.
model PatientTarget {
  id              String   @id @default(cuid())
  organizationId  String
  patientId       String   @unique
  patient         Patient  @relation(fields: [patientId], references: [id])
  kcalTarget      Int?
  proteinTargetG  Int?
  sessionsPerWeek Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("patient_targets")
}

// GLP-1 medication tracking (docs/build/slice-8-plan.md). The patient records
// the plan their prescriber gave them - Nutrionyx never suggests doses or
// schedules. The specialist reads plan + adherence, never edits (they do not
// prescribe). Monitoring context (docs/00 §3).
enum MedicationFrequency {
  WEEKLY
  DAILY
}

// Injection sites for subcutaneous GLP-1 pens (rotation guidance).
enum InjectionSite {
  LEFT_ARM
  RIGHT_ARM
  LEFT_BELLY
  RIGHT_BELLY
  LEFT_THIGH
  RIGHT_THIGH
}

// One plan per patient; configuration, editable by the patient. Dose history
// stays truthful because each MedicationDose snapshots drug + dose.
model MedicationPlan {
  id             String              @id @default(cuid())
  organizationId String
  patientId      String              @unique
  patient        Patient             @relation(fields: [patientId], references: [id])
  drugName       String
  genericName    String?
  frequency      MedicationFrequency @default(WEEKLY)
  doseMg         Decimal             @db.Decimal(6, 2)
  // 0 (Sunday) - 6 (Saturday); null for DAILY plans.
  shotDay        Int?
  active         Boolean             @default(true)
  // The patient's own reminder by default (owner decision 2026-08-13). Only
  // with this on does the specialist see the plan, the doses or the site
  // rotation; with it off the record shows nothing at all, because "follows a
  // medication and does not share it" leaks the sensitive part.
  //
  // Plans that existed before this column was added were set to true by the
  // migration: the consulta is the data controller and already holds that
  // history, so switching it off retroactively would leave a hole in a record
  // it answers for without unseeing anything.
  sharedWithSpecialist Boolean        @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@map("medication_plans")
}

// Append-only dose log (PRD_03 rules 5-6): never updated or deleted, a
// correction is a new row. Same pattern as Measurement.
model MedicationDose {
  id             String        @id @default(cuid())
  organizationId String
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  drugName       String
  doseMg         Decimal       @db.Decimal(6, 2)
  site           InjectionSite
  takenAt        DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([organizationId, patientId, takenAt])
  @@map("medication_doses")
}

// Single-use codes issued by the Nutrionyx owner to gate specialist
// (nutritionist) onboarding: creating a consulta requires redeeming one
// (docs/adr/0003). Redemption is atomic via an updateMany guard.
model SpecialistAccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  usedAt    DateTime?
  usedBy    String?
  createdBy String?
  createdAt DateTime  @default(now())

  @@map("specialist_access_codes")
}

// Platform-owner allowlist (docs/build/slice-3-plan.md, adr/0004). A user in
// this table is the platform Super Admin - business/platform operations only,
// never patient clinical data (operator-blindness).
model PlatformAdmin {
  id         String   @id @default(cuid())
  authUserId String   @unique
  note       String?
  createdAt  DateTime @default(now())

  @@map("platform_admins")
}

// Append-only consent log (adr/0006). A specialist accepts the DPA/GDPR terms
// at activation, before inviting patients. Never updated or deleted - a new
// acceptance is a new row. Org-scoped business metadata (operator-blindness
// safe). Versioned so a future terms version can require re-acceptance.
enum ConsentKind {
  DPA
}

model ConsentRecord {
  id                   String      @id @default(cuid())
  organizationId       String
  kind                 ConsentKind @default(DPA)
  termsVersion         String
  acceptedByAuthUserId String
  acceptedAt           DateTime    @default(now())

  @@index([organizationId, kind])
  @@map("consent_records")
}
